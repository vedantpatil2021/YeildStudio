# ---- OS / editors ------------------------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---- secrets (only the *.example files are committed) ------------------------------------------------------
# env files, in any folder
.env
.env.*
!.env.example
*.local
*.old
*.bak
# Google Cloud / Earth Engine credentials (EE_SERVICE_ACCOUNT_FILE, GOOGLE_APPLICATION_CREDENTIALS)
service-account*.json
*service_account*.json
credentials*.json
client_secret*.json
*-key.json
*_key.json
gcp*.json
token*.json
.config/earthengine/
# all JSON in backend/ is treated as secret (it has none of its own)
backend/**/*.json
# keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.crt
*.cer
id_rsa*
id_ed25519*
*.ppk
# other secret stores
secrets.*
*.secret
*.secrets
.npmrc
.pypirc
.netrc
*.kdbx
backend/pipeline/env.yaml
.supabase/

# ---- frontend (Node) ---------------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.log
# 30 m map layers (Cloud-Optimized GeoTIFFs, ~1.2 GB); rebuilt by frontend/scripts/build_demo_data.py
frontend/public/cog/

# ---- backend (Python) --------------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---- data --------------------------------------------------------------------------------------------------
# raw national county file (346 MB); the web copy is frontend/public/data/us_counties.geojson
data/boundaries/*.geojson

# ---- local logs (the app logs to stdout -> Loki; these only catch stray files) --------------------------------
logs/
*.log
*.log.[0-9]*
.run/

# ---- self-hosted Supabase runtime data (supabase/.env is covered by the .env rules above) ---------------------
supabase/volumes/db/data/
supabase/volumes/storage/*
!supabase/volumes/storage/.gitkeep
supabase/volumes/snippets/*
!supabase/volumes/snippets/.gitkeep
supabase/volumes/functions/*
!supabase/volumes/functions/deno.jsonc
!supabase/volumes/functions/main/
!supabase/volumes/functions/hello/
supabase/backups/
supabase/docker-compose.override.yml

# ---- kept locally, not in the repo -------------------------------------------------------------------------
supabase-local/
prototypes/
