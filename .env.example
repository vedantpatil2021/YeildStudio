# Settings for docker-compose.yml. Copy to .env (ignored by git) and fill in.
# App settings live in backend/.env and frontend/.env.local, not here.

# Grafana sign-in (http://localhost:3000). Required: compose refuses to start Grafana without a password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Host folders mounted into the backend (defaults shown)
# YIELD_MAPS_DIR=../../outputs/v2.0/yield_maps
# EE_CREDENTIALS_DIR=${HOME}/.config/earthengine

# Host ports, all bound to 127.0.0.1 (defaults shown)
# WEB_PORT=5173
# API_PORT=8000
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
