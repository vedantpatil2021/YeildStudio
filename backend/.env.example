# Copy to .env and fill in. Never commit .env.
# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for projects still on the legacy HS256 JWT secret; leave empty to verify with the project's JWKS
SUPABASE_JWT_SECRET=
# Supabase → Project Settings → Database → Connection string (URI, session pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Staging bucket in a free-tier region (us-central1, us-east1 or us-west1); needs GOOGLE_APPLICATION_CREDENTIALS
GCS_BUCKET=
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated list is allowed, e.g. http://localhost:5173,https://<user>.github.io
# Earth Engine: the lab's noncommercial Cloud project. Credentials: a service-account JSON key, or leave empty to use
# the `earthengine authenticate` credentials of the machine running the API.
EE_PROJECT=
EE_SERVICE_ACCOUNT_FILE=
EE_RUN_TIMEOUT=120
# Repository root that holds outputs/v2.0/yield_maps (defaults to this repository)
DATA_ROOT=
# Supabase → Project Settings → API Keys → secret key (or legacy service_role). Server only, never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated addresses that are admins (can invite) even before profiles.role is set
ADMIN_EMAILS=
